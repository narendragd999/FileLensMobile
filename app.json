{
  "expo": {
    "name": "FileLensPro",
    "slug": "filelens-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "filelenspro",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.filelenspro.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "FileLens needs access to your photo library to index and OCR images.",
        "NSPhotoLibraryAddUsageDescription": "FileLens needs to save OCR text exports to your photo library.",
        "NSDocumentsFolderUsageDescription": "FileLens needs access to Documents to index and search files.",
        "NSCameraUsageDescription": "FileLens can use the camera to scan documents for OCR."
      }
    },
    "android": {
      "package": "com.filelenspro.app",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.CAMERA",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "com.android.vending.BILLING"
      ],
      "minSdkVersion": 26,
      "targetSdkVersion": 36,
      "compileSdkVersion": 36,
      "largeHeap": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-sqlite",
      "expo-media-library",
      "expo-document-picker",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-asset",
      "@config-plugins/react-native-pdf",
      [
        "expo-share-intent",
        {
          "scheme": "filelenspro",
          "androidIntentFilters": [
            "*/*"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FileLens to access your camera to scan documents and QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false,
        "root": "./src/app"
      },
      "eas": {
        "projectId": "eeaa554a-2fb9-4608-9a9f-87b15ef7df22"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    }
  }
}